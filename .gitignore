node_modules/
dist/

# Build and capture artifacts from tools/. `.perf-snapshot` is a private copy of
# src/ that tools/perf.mjs builds from, so that a measurement is not silently
# taken against a tree six agents are editing underneath it.
.shot-build/
.shot*-build/
# Per-harness build output. Each measurement harness builds into its own dir so
# two of them running at once cannot serve each other's bundle.
dist-*/
# Scratch. The agreed home for ad-hoc harness output, one subdirectory each:
# a build pointed at a *shared* directory with emptyOutDir:true has already
# deleted two agents' private bundles mid-round. tools/scratch.mjs refuses it.
tmp/
.perf-snapshot/
.work/
tools/perf-out/
tools/shots/
tools/tmp/

# tools/budget.json is NOT ignored: the accepted cost ceiling is part of the
# source, and a budget nobody can diff is not a budget.
